# 環境選擇：development | testing | production，會讀取對應的 .env.{APP_ENV}
APP_ENV=development
BOT_CODE=1

# 執行開關
LOG_LEVEL=INFO
API_WEBSITE=false
DEBUG_MODE=true

# 資料庫（必填）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_database_password
DB_NAME=stardb

# 跨 process 訊息用的 Redis（7.0 以上），密碼寫在 URL 裡：redis://:<password>@host:6379/0；不設定時 bot 照常啟動，但收發不到跨 process 事件
REDIS_URL=redis://127.0.0.1:6379/0

# 網路
ZEROTIER_NETWORK_ID=replace_with_zerotier_network_id
# 自架 NetBird 時覆寫（預設 https://api.netbird.io）
NETBIRD_API_URL=https://api.netbird.io

# Discord 頻道與伺服器
TASK_REPORT=1001882729715085462
FEEDBACK_CHANNEL=902209434867073034
ERROR_REPORT=870929381621661697
REPORT_CHANNEL=876480208092422204
DM_CHANNEL=956523514389733408
MENTIONED_CHANNEL=999344358560120853
MENTION_EVERYONE_CHANNEL=999346052857606194
VIP_ADMIN_CHANNEL=1427543821977128960
HAPPYCAMP_GUILD=[566533708371329024]
DEBUG_GUILDS=[566533708371329024]

# auth server 內部 API（身分解析）；金鑰為 auth.env DOMALYZE_IDENTITY_INTERNAL_API_KEYS 裡 xingyubot 那把
AUTH_INTERNAL_URL=http://127.0.0.1:8002
AUTH_SERVICE_KEY=replace_with_auth_service_key
# auth server 對外網址，授權被拒時提示使用者到這裡註冊、連結 Twitch
AUTH_PUBLIC_URL=https://auth.domalyze.net
# 臨時與正式 ID 重查 auth server 的間隔（秒）
IDENTITY_TTL_SECONDS=3600
# Twitch 通行證的 provider，要等於 auth server 管理頁的 Twitch 登入方式代號
AUTH_TWITCH_PROVIDER=twitch
# Minecraft 通行證的 provider，要等於 auth server 管理頁的 Minecraft 登入方式代號
AUTH_MINECRAFT_PROVIDER=minecraft
# 管理員權限：auth server 身分組代號 -> 權限等級（0=一般 1~3=Level1~3），JSON；留空 {} 時所有人都是一般使用者
PRIVILEGE_ROLES={}

# 伺服器管理後台（API_WEBSITE=true 時必填）
# 前端網址：登入完成、取消授權後導回的位置
DASHBOARD_FRONTEND_URL=https://domalyze.net
# CORS 與 CSRF Origin 檢查允許的前端 origin，JSON 陣列；正式環境要含 www 與非 www
DASHBOARD_ALLOWED_ORIGINS=["https://domalyze.net","https://www.domalyze.net"]

# Sentry（由 sentry_bootstrap 直接讀取）
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_DEBUG=false
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.0
